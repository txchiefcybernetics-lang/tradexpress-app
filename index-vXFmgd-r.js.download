alue\n      }\n    }\n    edition {\n      current\n      requested\n    }\n    users {\n      ...SQLUser\n    }\n    databases {\n      data {\n        ...ResourceBaseData\n      }\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":GcpsqlServerFragmentDoc,"\n  fragment AWSSQLServer on AWSSQLServer {\n    storageGiB {\n      current\n      requested\n    }\n    maxStorageGiB {\n      current {\n        value\n      }\n      requested {\n        value\n      }\n    }\n    iops {\n      current {\n        value\n      }\n      requested {\n        value\n      }\n    }\n    storageType {\n      current\n      requested\n    }\n    backupRetentionDays {\n      current\n      requested\n    }\n    instanceClass {\n      current\n      requested\n    }\n    engineVersion {\n      current\n      requested\n    }\n    caCertificate {\n      current\n      requested\n    }\n    maxConnections {\n      current {\n        value\n      }\n      requested {\n        value\n      }\n    }\n    poolConfig {\n      id\n      reservedConnections\n    }\n    users {\n      ...SQLUser\n    }\n    databases {\n      data {\n        ...ResourceBaseData\n      }\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":AwssqlServerFragmentDoc,"\n  fragment SQLDatabase on SQLDatabase {\n    data {\n      ...ResourceBaseData\n    }\n    server {\n      data {\n        name\n        cloudDashboardURL\n      }\n    }\n  }\n":SqlDatabaseFragmentDoc,"\n  fragment AWSAppLoadBalancer on AWSAppLoadBalancer {\n    data {\n      ...ResourceBaseData\n    }\n    idleTimeoutSeconds {\n      requested\n      current\n    }\n  }\n":AwsAppLoadBalancerFragmentDoc,"\n  fragment AWSFargateTaskDefinition on AWSFargateTaskDefinition {\n    memoryMiB {\n      requested\n      current\n    }\n    numCPUs {\n      requested\n      current\n    }\n    service {\n      data {\n        ...ResourceBaseData\n      }\n      desiredCount {\n        requested\n        current\n      }\n    }\n    services {\n      id\n      encoreName\n      created\n    }\n    gateways {\n      id\n      encoreName\n      created\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":AwsFargateTaskDefinitionFragmentDoc,"\n  fragment GCPCloudRun on GCPCloudRun {\n    numCPUs {\n      current\n      requested\n    }\n    memoryMiB {\n      current\n      requested\n    }\n    gen {\n      current\n      requested\n    }\n    minInstances {\n      current\n      requested\n    }\n    maxInstances {\n      current\n      requested\n    }\n    alwaysOnCPU {\n      current\n      requested\n    }\n    startupCPUBoost {\n      current\n      requested\n    }\n    requestTimeout {\n      current\n      requested\n    }\n    vpcEgress {\n      current\n      requested\n    }\n    maxConcurrency {\n      current\n      requested\n    }\n    services {\n      id\n      encoreName\n      created\n    }\n    gateways {\n      id\n      encoreName\n      created\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":GcpCloudRunFragmentDoc,"\n  fragment EncoreCloudAppRun on EncoreCloudAppRun {\n    memoryMiB {\n      current\n    }\n    numCPUs {\n      current\n    }\n    data {\n      ...ResourceBaseData\n    }\n    services {\n      id\n      encoreName\n      created\n    }\n    gateways {\n      id\n      encoreName\n      created\n    }\n  }\n":EncoreCloudAppRunFragmentDoc,"\n  fragment AWSRedisCluster on AWSRedisCluster {\n    config {\n      evictionStrategy\n    }\n    primaryHost\n    readReplicaHost\n    numReadReplicas {\n      requested\n      current\n    }\n    nodeType {\n      requested\n      current\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":AwsRedisClusterFragmentDoc,"\n  fragment GCPRedisCluster on GCPRedisCluster {\n    config {\n      evictionStrategy\n    }\n    primaryHost\n    readReplicaHost\n    numReadReplicas {\n      requested\n      current\n    }\n    memoryGiB {\n      requested\n      current\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":GcpRedisClusterFragmentDoc,"\n  fragment GCPK8sNodePool on GCPK8sNodePool {\n    autoscaling {\n      current\n      requested\n    }\n    totalMaxNodes {\n      requested\n      current\n    }\n    totalMinNodes {\n      requested\n      current\n    }\n    machineType {\n      requested\n      current\n    }\n    spotInstances {\n      requested\n      current\n    }\n    diskType {\n      requested\n      current\n    }\n    storageGiB {\n      requested\n      current\n    }\n    imageType {\n      requested\n      current\n    }\n    zones {\n      requested\n      current\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":Gcpk8sNodePoolFragmentDoc,"\n  fragment K8sDeployment on K8sDeployment {\n    replicas {\n      current\n      requested\n    }\n    containers {\n      numCPUs {\n        requested {\n          value\n        }\n        current {\n          value\n        }\n      }\n      memoryMiB {\n        requested {\n          value\n        }\n        current {\n          value\n        }\n      }\n      requestNumCPUs {\n        requested {\n          value\n        }\n        current {\n          value\n        }\n      }\n      requestMemoryMiB {\n        requested {\n          value\n        }\n        current {\n          value\n        }\n      }\n      services {\n        id\n        encoreName\n        created\n      }\n      gateways {\n        id\n        encoreName\n        created\n      }\n      data {\n        ...ResourceBaseData\n      }\n    }\n    data {\n      ...ResourceBaseData\n    }\n  }\n":K8sDeploymentFragmentDoc,"\n  fragment DeleteNodeAction on DeleteNodeAction {\n    id\n    conclusion\n    resource\n    status\n  }\n":DeleteNodeActionFragmentDoc,"\n  fragment MoveNeedAction on MoveNeedAction {\n    id\n    conclusion\n    status\n    needs\n    to\n  }\n":MoveNeedActionFragmentDoc,"\n  fragment UpdateResourceAction on UpdateResourceAction {\n    id\n    conclusion\n    status\n    resourceID\n    updates\n  }\n":UpdateResourceActionFragmentDoc,"\n  fragment BatchUpdateResourceAction on BatchUpdateResourceAction {\n    id\n    conclusion\n    status\n    resourceIDs\n    updates\n  }\n":BatchUpdateResourceActionFragmentDoc,"\n  fragment MoveToImportAction on MoveToImportAction {\n    id\n    conclusion\n    status\n    need\n    path\n    type\n  }\n":MoveToImportActionFragmentDoc,"\n  fragment MarkUserManagedAction on MarkUserManagedAction {\n    id\n    conclusion\n    status\n    resource\n    value\n    recursive\n  }\n":MarkUserManagedActionFragmentDoc,"\n  fragment AWSK8sCluster on AWSK8sCluster {\n    enablePublicAccess {\n      current\n      requested\n    }\n    autoUpdate {\n      current\n      requested\n    }\n    version {\n      current\n      requested\n    }\n    data {\n      ...ResourceBaseData\n    }\n    deployments {\n      ...K8sDeployment\n    }\n  }\n":Awsk8sClusterFragmentDoc,"\n  fragment GCPK8sCluster on GCPK8sCluster {\n    privateCluster {\n      current\n    }\n    privateEndpoint {\n      current\n    }\n    autopilot {\n      current\n    }\n    data {\n      ...ResourceBaseData\n    }\n    nodePools {\n      ...GCPK8sNodePool\n    }\n    deployments {\n      ...K8sDeployment\n    }\n  }\n":Gcpk8sClusterFragmentDoc,'\n  query getInfraResources($appSlug: String!, $envSlug: String!, $proposal: Boolean) {\n    app(slug: $appSlug) {\n      id\n      slug\n      env(name: $envSlug, includeDeleted: true) {\n        id\n        name\n        deleted\n        cloud\n        resourceMetadata {\n          aws {\n            rdsInstanceClasses {\n              name\n              memoryMiB\n              numCPUs\n            }\n            redisNodeTypes {\n              name\n              memoryGiB\n            }\n            rdsCACertificates\n            rdsEngineVersions\n            eksVersions\n          }\n          gcp {\n            cloudSQLMachineTypes {\n              enterprisePlus {\n                name\n                numCPUs\n                memoryMiB\n              }\n            }\n          }\n        }\n        costCollectors {\n          currency\n          latestExport\n          oldestExport\n          backfilledBy\n          unattributedCosts {\n            cost1Day\n            cost1DayPrev\n            cost7Day\n            cost7DayPrev\n            cost28Day\n            cost28DayPrev\n            sku {\n              description\n            }\n            minDate\n          }\n        }\n        infraActions(sel: { status: PROPOSED }) {\n          id\n          ...DeleteNodeAction\n          ...MoveNeedAction\n          ...UpdateResourceAction\n          ...BatchUpdateResourceAction\n          ...MoveToImportAction\n          ...MarkUserManagedAction\n        }\n        infraChanges(sel: { limit: 1, status: COMPLETED }) {\n          rolloutID\n          conclusion\n          status\n        }\n        needs(sel: { typeRefs: "need.Service" }) {\n          encoreName\n        }\n        resources(proposed: $proposal) {\n          ...PubSubTopic\n          ...PubSubSubscription\n          ...GCPSQLServer\n          ...AWSSQLServer\n          ...AWSFargateTaskDefinition\n          ...SQLDatabase\n          ...GCPCloudRun\n          ...EncoreCloudAppRun\n          ...AWSRedisCluster\n          ...GCPRedisCluster\n          ...BasicResource\n          ...GCPK8sCluster\n          ...K8sDeployment\n          ...GCPK8sNodePool\n          ...FullNeonAccount\n          ...AWSK8sCluster\n          ...Bucket\n          ...AWSAppLoadBalancer\n          data {\n            ...ResourceBaseData\n          }\n        }\n      }\n    }\n  }\n':GetInfraResourcesDocument,'\n  query getInfraDeployResources($appSlug: String!, $envSlug: String!, $rolloutID: RolloutID!) {\n    app(slug: $appSlug) {\n      id\n      slug\n      env(name: $envSlug, includeDeleted: true) {\n        resourceMetadata {\n          aws {\n            eksVersions\n            rdsInstanceClasses {\n              name\n              memoryMiB\n              numCPUs\n            }\n            redisNodeTypes {\n              name\n              memoryGiB\n            }\n            rdsCACertificates\n            rdsEngineVersions\n          }\n          gcp {\n            cloudSQLMachineTypes {\n              enterprisePlus {\n                name\n                numCPUs\n                memoryMiB\n              }\n            }\n          }\n        }\n        needs(sel: { typeRefs: "need.Service" }) {\n          encoreName\n        }\n        rollouts(sel: { id: $rolloutID }) {\n          id\n          status\n          conclusion\n          build {\n            id\n            status\n            commitHash\n          }\n          deploy {\n            id\n          }\n          cleanup {\n            id\n          }\n          infraChange {\n            id\n            status\n            conclusion\n            commitHash\n            type\n            rolloutID\n            changes {\n              action\n              requiresRestart\n              providerUpdate\n              changedFields\n              resource {\n                ...PubSubTopic\n                ...PubSubSubscription\n                ...GCPSQLServer\n                ...AWSSQLServer\n                ...AWSFargateTaskDefinition\n                ...SQLDatabase\n                ...GCPCloudRun\n                ...EncoreCloudAppRun\n                ...AWSRedisCluster\n                ...GCPRedisCluster\n                ...AWSK8sCluster\n                ...GCPK8sCluster\n                ...K8sDeployment\n                ...GCPK8sNodePool\n                ...FullNeonAccount\n                ...BasicResource\n                ...Bucket\n                ...AWSAppLoadBalancer\n                data {\n                  ...ResourceBaseData\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n':GetInfraDeployResourcesDocument,"\n  mutation deleteResource(\n    $appSlug: String!\n    $envName: String!\n    $id: ResourceID!\n    $confirmation: String!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envName, includeDeleted: false) {\n        approveDeleteResource(id: $id, confirmation: $confirmation, proposal: true) {\n          ...DeleteNodeAction\n        }\n      }\n    }\n  }\n":DeleteResourceDocument,"\n  mutation cancelDeleteResource($appSlug: String!, $envName: String!, $id: ActionID!) {\n    app(slug: $appSlug) {\n      env(name: $envName, includeDeleted: false) {\n        actions(sel: { id: $id, status: PROPOSED }) {\n          cancel {\n            ...DeleteNodeAction\n          }\n        }\n      }\n    }\n  }\n":CancelDeleteResourceDocument,"\n  mutation updateResourceCloudName(\n    $appSlug: String!\n    $envSlug: String!\n    $resourceID: ResourceID!\n    $name: CloudName!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        resources(sel: { id: $resourceID }) {\n          updateCloudName(name: $name) {\n            id\n          }\n        }\n      }\n    }\n  }\n":UpdateResourceCloudNameDocument,"\n  mutation batchEditInfra(\n    $appSlug: String!\n    $envName: String!\n    $ids: [ResourceID!]!\n    $updates: Map!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envName, includeDeleted: false) {\n        batchUpdateResource(ids: $ids, updates: $updates, proposal: true) {\n          id\n        }\n      }\n    }\n  }\n":BatchEditInfraDocument,"\n  mutation editInfra($appSlug: String!, $envName: String!, $id: ResourceID!, $updates: Map!) {\n    app(slug: $appSlug) {\n      env(name: $envName, includeDeleted: false) {\n        updateResource(id: $id, updates: $updates, proposal: true) {\n          id\n        }\n      }\n    }\n  }\n":EditInfraDocument,"\n  mutation markResourceUserManaged(\n    $appSlug: String!\n    $envName: String!\n    $id: ResourceID!\n    $value: Boolean!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envName) {\n        resources(sel: { id: $id }) {\n          markUserManaged(value: $value, recursive: false, proposal: true) {\n            id\n          }\n        }\n      }\n    }\n  }\n":MarkResourceUserManagedDocument,"\n  mutation createOauthClient($appSlug: String!, $roles: [String!]!, $description: String!) {\n    app(slug: $appSlug) {\n      createOAuth2Client(roles: $roles, description: $description) {\n        id\n        clientSecret\n        roles\n        description\n        createdBy\n        createdAt\n      }\n    }\n  }\n":CreateOauthClientDocument,"\n  mutation revokeOauthClient($appSlug: String!, $id: OAuth2ClientID!) {\n    app(slug: $appSlug) {\n      oauth2Client(id: $id) {\n        revoke(confirm: true) {\n          id\n          roles\n          description\n          createdBy\n          createdAt\n          revokedAt\n        }\n      }\n    }\n  }\n":RevokeOauthClientDocument,"\n  query listOauthTokens($appSlug: String!) {\n    app(slug: $appSlug) {\n      oauth2Clients {\n        id\n        roles\n        description\n        createdBy\n        createdAt\n        revokedAt\n      }\n    }\n  }\n":ListOauthTokensDocument,"\n  query getMembers($appSlug: String!) {\n    app(slug: $appSlug) {\n      members {\n        role\n        accepted\n        expires\n        invited\n        user {\n          id\n          email\n          picture_url\n          full_name\n          given_name\n          family_name\n        }\n      }\n    }\n  }\n":GetMembersDocument,"\n  mutation connectAWSAccount(\n    $appSlug: String!\n    $name: String!\n    $roleArn: String!\n    $externalId: String!\n  ) {\n    app(slug: $appSlug) {\n      connectAWSAccount(name: $name, roleArn: $roleArn, externalId: $externalId) {\n        id\n      }\n    }\n  }\n":ConnectAwsAccountDocument,"\n  mutation removeAWSAccount($appSlug: String!, $id: IntegrationID!) {\n    app(slug: $appSlug) {\n      integrations(sel: { id: $id }) {\n        delete(confirm: true)\n      }\n    }\n  }\n":RemoveAwsAccountDocument,"\n  mutation renameAWSAc