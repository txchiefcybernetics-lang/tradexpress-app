var item struct {
    ID    int64
    Title string
    Done  bool
}
err := sqldb.QueryRow(ctx, \`
    SELECT id, title, done
    FROM todo_item
    LIMIT 1
\`).Scan(&item.ID, &item.Title, &item.Done)
`.trim()}),jsxRuntimeExports.jsxs("p",{children:[jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"Hint:"})," If ",jsxRuntimeExports.jsx("code",{children:"sqldb.QueryRow"})," does not find a matching row, it reports an error that can be checked against by importing the standard library ",jsxRuntimeExports.jsx("code",{children:"errors"})," package and calling"," ",jsxRuntimeExports.jsx("code",{children:"errors.Is(err, sqldb.ErrNoRows)"}),"."]})]})},{nav:"Reading multiple rows",content:jsxRuntimeExports.jsxs("div",{className:"space-y-5",children:[jsxRuntimeExports.jsxs("p",{children:["To read multiple todo items in the example schema above, we can use"," ",jsxRuntimeExports.jsx("code",{children:"sqldb.Query"}),":"]}),jsxRuntimeExports.jsx(Code,{lang:"go",rawContents:`
import "encore.dev/storage/sqldb"

type item struct {
    ID    int64
    Title string
    Done  bool
}

rows, err := sqldb.Query(ctx, "SELECT id, title, done FROM todo_item")
if err != nil {
    return nil, err
}
defer rows.Close() // IMPORTANT: close the database cursor when we're done

var items []item
for rows.Next() {
    var it item
    if err := rows.Scan(&it.ID, &it.Title, &it.Done); err != nil {
      return nil, err
    }
    items = append(items, it)
}
if err := rows.Err(); err != nil {
    return nil, err
}
return items, nil
`.trim()})]})}]},objectStorageSection={slug:"storage",heading:"Object Storage",overviewText:"Store and retrieve files and unstructured data.",icon:td=>icons.database(td.className??""),description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["Object Storage provides a simple and scalable solution to store files and unstructured data. Encore provides a cloud-agnostic API that works with Amazon S3, Google Cloud Storage, and any S3-compatible service. ",docLink("/go/primitives/object-storage")]}),subSections:[{nav:"Creating a Bucket",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsx("p",{children:"Buckets must be declared as package level variables and can be accessed from any service."}),jsxRuntimeExports.jsx(Code,{lang:"go",rawContents:`
