import "encore.dev/storage/sqldb"

// insert inserts a todo item into the database.
func insert(ctx context.Context, id, title string, done bool) error {
	_, err := sqldb.Exec(ctx, \`
		INSERT INTO todo_item (id, title, done)
		VALUES ($1, $2, $3)
	\`, id, title, done)
	return err
}
`.trim()})]})},{nav:"Reading a single row",content:jsxRuntimeExports.jsxs("div",{className:"space-y-5",children:[jsxRuntimeExports.jsxs("p",{children:["To read a single todo item in the example schema above, we can use"," ",jsxRuntimeExports.jsx("code",{children:"sqldb.QueryRow"}),":"]}),jsxRuntimeExports.jsx(Code,{lang:"go",rawContents:`
