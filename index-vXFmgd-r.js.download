    if err == nil {
        log.Println(resp.Message) // "Hello, World!"
    }
    return err
}
`.trim()}),jsxRuntimeExports.jsxs("p",{className:"mt-5",children:[jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"Hint:"})," Import the service package and call the API endpoint using a regular function call."]})]})},{nav:"Raw endpoints",content:jsxRuntimeExports.jsx(jsxRuntimeExports.Fragment,{children:jsxRuntimeExports.jsx(Code,{lang:"go",rawContents:`
