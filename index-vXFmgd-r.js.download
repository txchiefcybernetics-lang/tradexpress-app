        /* Make Plain chat launcher glass-like */
        #plain-chat-launcher,
        [data-plain-chat-launcher],
        [data-plain-chat] button[aria-label*="Open"],
        [data-plain-chat] button[aria-label*="chat"],
        div[id*="plain"] button,
        button[class*="plain-chat"],
        button[style*="background"] {
          background: rgba(17, 17, 17, 0.7) !important;
          backdrop-filter: blur(8px) !important;
          -webkit-backdrop-filter: blur(8px) !important;
        }

        /* Hide Plain chat on mobile (below md / 768px) */
        @media (max-width: 767px) {
          #plain-chat-launcher,
