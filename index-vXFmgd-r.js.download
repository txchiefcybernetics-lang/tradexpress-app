import { Topic, Attribute } from "encore.dev/pubsub";

export interface CartEvent {
	shoppingCartID: Attribute<number>;
	event: string;
}

export const cartEvents = new Topic<CartEvent>("cart-events", {
	deliveryGuarantee: "at-least-once",
	// Publications with the same shoppingCartID will be delivered in the order that they were published
	orderingAttribute: "shoppingCartID",
})
`})}]},secretsSection$1={slug:"secrets",heading:"Secrets",overviewText:"Setting and using secrets.",description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["Here are some snippets for using Encore's secrets management functionality."," ",docLink("/ts/primitives/secrets")]}),icon:ForwardRef$9,subSections:[{nav:"Setting a secret",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Setting a secret",docsLink:"/ts/primitives/secrets#storing-secret-values",lang:"bash",value:`
