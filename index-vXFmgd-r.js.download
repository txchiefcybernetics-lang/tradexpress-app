import { api } from "encore.dev/api";
//-- import

//-- response
interface Response {
  message: string;
}

//-- response
//-- handler
export const get = api(
  { method: "GET", path: "/hello", expose: true },
  async (): Promise<Response> => {
    return { message: "Hello" };
  },
);
//-- handler
