`,ExposeAPIsLesson=({lesson:td,group:ed})=>jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs(LessonIntro,{group:ed,lesson:td,children:[jsxRuntimeExports.jsx("p",{children:"By default, when you define an API, it is not exposed externally and can only be accessed by other APIs within the same Encore application."}),jsxRuntimeExports.jsxs("p",{children:["To expose an API to the internet, add the ",jsxRuntimeExports.jsx("code",{children:"expose: true"})," field to the options object passed in as the first argument to ",jsxRuntimeExports.jsx("code",{children:"api"}),"."]}),jsxRuntimeExports.jsx(DocsLink,{title:"Expose APIs docs",href:"https://encore.dev/docs/ts/primitives/defining-apis#exposing-api-endpoints-to-the-outside-world"})]}),jsxRuntimeExports.jsx(QuizTaskInstructions,{lesson:td,group:ed,title:jsxRuntimeExports.jsx("span",{children:"Which endpoint is public and callable outside of the application?"}),alternatives:[{text:jsxRuntimeExports.jsx(CodeSnippet$1,{hideHeader:!0,value:endpoint1}),correct:!1,message:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["Endpoints default to being private if ",jsxRuntimeExports.jsx("code",{children:"expose"})," is not set in the options object."]})},{text:jsxRuntimeExports.jsx("div",{className:"w-[450px]",children:jsxRuntimeExports.jsx(CodeSnippet$1,{hideHeader:!0,value:endpoint2})}),correct:!1,message:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["This endpoint is private because ",jsxRuntimeExports.jsx("code",{children:"expose"})," has been set to"," ",jsxRuntimeExports.jsx("code",{children:"false"}),"."]})},{text:jsxRuntimeExports.jsx(CodeSnippet$1,{hideHeader:!0,value:endpoint3}),correct:!0,message:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["That was correct. You make an endpoint public by specifying"," ",jsxRuntimeExports.jsx("code",{children:"expose: true"})," in the APIs options object."]})}],bonus:jsxRuntimeExports.jsx(jsxRuntimeExports.Fragment,{children:jsxRuntimeExports.jsx("p",{children:"Private endpoints are always callable from the API Explorer and from Cron Jobs."})})})]}),exposeAPIsLesson={title:"Public/Private APIs",slug:"expose-api",page:ExposeAPIsLesson},codeContent$4=`//-- import
import { authHandler } from "encore.dev/auth";
import { Header, Gateway } from "encore.dev/api";
//-- import

//-- params
// The request information our auth handler is interested in is the \`Authorization\` header.
interface AuthParams {
  authorization: Header<"Authorization">;
}

// Our auth handler will make the \`userID\` available to endpoints.
interface AuthData {
  userID: string;
}
//-- params

//-- handler
export const auth = authHandler<AuthParams, AuthData>(async (params) => {
  // TODO: Look up information about the user based on the authorization header.
  return { userID: "my-user-id" };
});
//-- handler

//-- gateway
export const gateway = new Gateway({
  authHandler: auth,
});
//-- gateway
`,AuthHandlerLesson=({lesson:td,group:ed})=>{const{meta:nd}=useProcessUpdate(),rd="hello/auth.ts",sd=()=>{if(!nd)return!1;const{gateways:od}=nd;return od.some(cd=>cd.explicit?.auth_handler)};return jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs(LessonIntro,{group:ed,lesson:td,children:[jsxRuntimeExports.jsx("p",{children:"Almost every app needs to identify its user, whether it's an individual in a consumer app or an organization in a B2B app. Encore supports this in a simple way by letting you define an authentication handler to inspect requests and identify the authenticated user."}),jsxRuntimeExports.jsx("p",{children:"The authentication handler is responsible for inspecting incoming requests to determine what user is authenticated (if any), and computing any other associated authentication information."}),jsxRuntimeExports.jsx(DocsLink,{title:"Authenticating users docs",href:"https://encore.dev/docs/ts/develop/auth"})]}),jsxRuntimeExports.jsx(CodeTaskInstructions,{lesson:td,group:ed,title:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsx("span",{children:"Add an Auth handler to"})," ",jsxRuntimeExports.jsx(OpenFileInEditor,{path:rd})]}),description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{children:["To complete the task, open ",jsxRuntimeExports.jsx(OpenFileInEditor,{path:rd})," in your editor and implement an Auth handler, then ",jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"save your file"}),"."]}),jsxRuntimeExports.jsxs("p",{children:["To implement a GET endpoint, first import the ",jsxRuntimeExports.jsx("code",{children:"authHandler"})," function from the ",jsxRuntimeExports.jsx("code",{children:"encore.dev/auth"})," module. We will also import the ",jsxRuntimeExports.jsx("code",{children:"Header"})," ","type and the ",jsxRuntimeExports.jsx("code",{children:"Gateway"})," class."]}),jsxRuntimeExports.jsx(CodeSnippet$1,{title:"Import statements",value:getPartOfContent(codeContent$4,"import")}),jsxRuntimeExports.jsx("p",{children:"Define the request information the auth handler is interested in and the data about the authenticated user that the auth handler makes available."}),jsxRuntimeExports.jsx(CodeSnippet$1,{title:"Defining params",value:getPartOfContent(codeContent$4,"params")}),jsxRuntimeExports.jsxs("p",{children:["The ",jsxRuntimeExports.jsx("code",{children:"authHandler"})," function takes in an ",jsxRuntimeExports.jsx("code",{children:"async"})," function that receives the params as input and should return the auth data. The ",jsxRuntimeExports.jsx("code",{children:"userID"})," ","is hardcoded in this example, but in a real-world application you would look up information about the user based on the ",jsxRuntimeExports.jsx("code",{children:"params"}),"."]}),jsxRuntimeExports.jsx(CodeSnippet$1,{title:"Auth handler",value:getPartOfContent(codeContent$4,"handler")}),jsxRuntimeExports.jsx("p",{children:"The last step is to define the API Gateway that will process incoming requests to your application."}),jsxRuntimeExports.jsx(CodeSnippet$1,{title:"Gateway",value:getPartOfContent(codeContent$4,"gateway")}),jsxRuntimeExports.jsxs("p",{children:["When you’re done, press ",jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"Check"})," to see if you got it right."]})]}),onCheck:sd,bonus:jsxRuntimeExports.jsx(jsxRuntimeExports.Fragment,{children:jsxRuntimeExports.jsxs("p",{children:["You can use any authentication provider you like inside the auth handler. In our example repo you can find examples of using"," ",jsxRuntimeExports.jsx("a",{href:"https://github.com/encoredev/examples/tree/main/ts/auth0-react-sdk",target:"_blank",className:"link-brandient",children:"Auth0"})," ","and"," ",jsxRuntimeExports.jsx("a",{href:"https://github.com/encoredev/examples/tree/main/ts/clerk",target:"_blank",className:"link-brandient",children:"Clerk"})," ","together with Encore."]})}),solution:jsxRuntimeExports.jsx(CodeSnippet$1,{title:"Auth handler example",value:getPartOfContent(codeContent$4,void 0,!0)})})]})},authHandlerLesson={title:"Authentication (part 1)",slug:"auth-1",page:AuthHandlerLesson},codeContent$3=`//-- task-start
//-- task-solution
import { api } from "encore.dev/api";
//-- task-end
//-- import
import log from "encore.dev/log";
import { getAuthData } from "~encore/auth";
//-- import

//-- task-start
//-- task-solution
interface Response {
  message: string;
}

//-- task-end
//-- handler
export const admin = api(
  {
    auth: true, // Require the user to be authenticated
    expose: true,
    method: "GET",
    path: "/admin",
  },
  async (): Promise<Response> => {
    const userID = getAuthData()!.userID;
    log.info("Data requested by user", { userID });

    return { message: "Secret message for admins" };
  },
);
//-- handler
`,AuthEndpointLesson=({lesson:td,group:ed})=>{const{meta:nd}=useProcessUpdate(),rd="hello/hello.ts",sd=()=>{if(!nd)return!1;const{svcs:od}=nd;return od.some(cd=>cd.rpcs.some(ud=>!ud.allow_unauthenticated))};return jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs(LessonIntro,{group:ed,lesson:td,children:[jsxRuntimeExports.jsxs("p",{children:["To require authentication for an API endpoint, add ",jsxRuntimeExports.jsx("code",{children:"auth: true"})," to the API options. With this option, Encore will first call the authentication handler you've defined to validate the authentication of incoming requests."]}),jsxRuntimeExports.jsxs("p",{children:["Setting ",jsxRuntimeExports.jsx("code",{children:"auth: true"})," can also be useful for internal APIs that aren't exposed to the internet. In that case, it means that the internal caller must have valid authentication data associated with its request."]}),jsxRuntimeExports.jsx(DocsLink,{title:"Auth endpoints docs",href:"https://encore.dev/docs/ts/primitives/apis#requiring-authentication-data"})]}),jsxRuntimeExports.jsx(CodeTaskInstructions,{lesson:td,group:ed,title:jsxRuntimeExports.jsx(jsxRuntimeExports.Fragment,{children:jsxRuntimeExports.jsxs("span",{children:["Add an endpoint to ",jsxRuntimeExports.jsx(OpenFileInEditor,{path:rd})," that requires authentication"]})}),description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{children:["To complete the task, open ",jsxRuntimeExports.jsx(OpenFileInEditor,{path:rd})," in your editor and implement an endpoint that has ",jsxRuntimeExports.jsx("code",{children:"auth"})," set to ",jsxRuntimeExports.jsx("code",{children:"true"})," in the API options, then ",jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"save your file"}),"."]}),jsxRuntimeExports.jsxs("p",{children:["Add an import for the ",jsxRuntimeExports.jsx("code",{children:"log"})," function. With the ",jsxRuntimeExports.jsx("code"