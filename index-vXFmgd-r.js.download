import {Service} from "encore.dev/service";

export default new Service("my-service");
   `}),jsxRuntimeExports.jsx("p",{children:"That's it! Encore will consider this directory and all its subdirectories as part of the service."}),docLink("/ts/primitives/services")]}),subSections:[{nav:"Application structure",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{children:["For more on how to structure your application, refer to the"," ",jsxRuntimeExports.jsx("a",{href:"https://encore.dev/docs/ts/primitives/app-structure",target:"_blank",className:"link-brandient brandient-5",children:"app structure guide"}),".",jsxRuntimeExports.jsx("br",{}),jsxRuntimeExports.jsx("br",{}),"As an example, an application with two services, ",jsxRuntimeExports.jsx("code",{children:"hello"})," and"," ",jsxRuntimeExports.jsx("code",{children:"world"}),", might look like this on disk:"]}),jsxRuntimeExports.jsx(Code,{lang:"ts",rawContents:`
              /my-app
├── encore.app                       // ... and other top-level project files
│
├── hello                            // hello service (directory)
│  ├── migrations                   // hello service db migrations (directory)
│  │   └── 1_create_table.up.sql    // hello service db migration
│  ├── encore.service.ts            // hello service definition
│  ├── hello.ts                     // hello service APIs
│  └── hello_test.ts                // tests for hello service
│
└── world                            // world service (directory)
│   ├── encore.service.ts            // world service definition
    └── world.ts                     // world service APIs
`.trim()})]})}]},apiSection$1={slug:"api",heading:"APIs",overviewText:"Define and call APIs.",icon:td=>icons.puzzle(td.className??""),description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["To define an API, use the ",jsxRuntimeExports.jsx("code",{children:"api"})," function from the ",jsxRuntimeExports.jsx("code",{children:"encore.dev/api"})," ","module to wrap a regular TypeScript ",jsxRuntimeExports.jsx("code",{children:"async"})," function that receives the request data as input and returns response data. ",docLink("/ts/primitives/defining-apis")]}),subSections:[{nav:"Defining APIs",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Defining APIs",docsLink:"/ts/primitives/apis",lang:"ts",value:`
import { api } from "encore.dev/api"

interface PingParams {
  name: string;
}

interface PingResponse {
  message: string;
}

export const ping = api(
  { method: "POST", path: "/hello" },
  async (p: PingParams): Promise<PingResponse> => {
    return { message: \`Hello \${p.name}!\` };
  }
);`})},{nav:"Calling APIs",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Calling APIs",docsLink:"/ts/primitives/api-calls",lang:"ts",value:`
import { hello } from "~encore/clients"; // import 'hello' service

export const myOtherAPI = api({}, async (): Promise<void> => {
    const resp = await hello.ping({ name: "World" });
    console.log(resp.message); // "Hello World!"
  }
);`})},{nav:"Streaming Endpoints",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{className:"mt-5",children:["To define a streaming api endpoint, use ",jsxRuntimeExports.jsx("code",{children:"api.streamInOut"}),","," ",jsxRuntimeExports.jsx("code",{children:"api.streamOut"})," or ",jsxRuntimeExports.jsx("code",{children:"api.streamIn"})," from the"," ",jsxRuntimeExports.jsx("code",{children:"encore.dev/api"})," module. You define the streams incoming and outgoing types as type parameters. ",docLink("/ts/primitives/streaming-apis")]}),jsxRuntimeExports.jsx(CodeSnippet,{title:"InOut Stream",docsLink:"/ts/primitives/streaming-apis",lang:"ts",value:`
interface Incoming {
  type: "ping";
}

interface Outgoing {
  type: "pong";
}

export const pingpong = api.streamInOut<Incoming, Outgoing>(
  { expose: true, path: "/pingpong" },
  async (stream) => {
    for await (const ping of stream) {
      await stream.send({ type: "pong" });
    }
  },
);
`})]})},{nav:"Raw Endpoints",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{className:"mt-5",children:["If you need to operate at a lower abstraction level, Encore supports defining raw endpoints that let you access the underlying HTTP request. This is often useful for things like accepting webhooks.",jsxRuntimeExports.jsx("br",{}),jsxRuntimeExports.jsx("br",{}),"To define a raw endpoint, use the ",jsxRuntimeExports.jsx("code",{children:"api.raw"})," function. It works similarly to normal ",jsxRuntimeExports.jsx("code",{children:"api"}),", but does not accept a request and response schema. Instead, it works like the Node.js ",jsxRuntimeExports.jsx("code",{children:"http"})," module and Express.js, where the function receives two parameters: a request object and a response writer.",jsxRuntimeExports.jsx("br",{}),jsxRuntimeExports.jsx("br",{}),"It looks like this:"]}),jsxRuntimeExports.jsx(CodeSnippet,{title:"Raw Endpoints",docsLink:"/ts/primitives/raw-endpoints",lang:"ts",value:`
import { api } from "encore.dev/api";

export const myRawEndpoint = api.raw(
  { expose: true, path: "/raw", method: "GET" },
  async (req, resp) => {
    resp.writeHead(200, { "Content-Type": "text/plain" });
    resp.end("Hello, raw world!");
  },
);`})]})},{nav:"Query string and HTTP headers",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Query string and HTTP headers",docsLink:"/ts/primitives/apis#api-schemas",lang:"ts",value:`
import { api, Header, Query } from "encore.dev/api";


interface Data {
	header: Header<"X-Header">; // this field will be read from the http header
	query: Query<string>;       // this will be parsed from the '?query=...' parameter in the request url
	body:  string;              // this will be sent as part of the JSON body

    // These will also sent as part of the JSON body:
	nested: {
        body2: string;
    };
}

export const echo = api(
    {method: "POST", path: "/echo"},
    async (params: Data): Promise<Data> => {
        return params;  // echo the data back
    },
)
`})},{nav:"Returning errors",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Error codes",docsLink:"/ts/develop/errors",lang:"ts",value:`
import { APIError } from "encore.dev/api";

// Throw inside an API function to return an error response.

throw APIError.canceled("message"); // 499 Client Closed Request

throw APIError.unknown("message"); // 500 Internal Server Error

throw APIError.invalidArgument("message"); // 400 Bad Request

throw APIError.deadlineExceeded("message"); // 504 Gateway Timeout

throw APIError.notFound("message"); // 404 Not Found

throw APIError.alreadyExists("message"); // 409 Conflict

throw APIError.permissionDenied("message"); // 403 Forbidden

throw APIError.resourceExhausted("message"); // 429 Too Many Requests

throw APIError.failedPrecondition("message"); // 400 Bad Request

throw APIError.aborted("message"); // 409 Conflict

throw APIError.outOfRange("message"); // 400 Bad Request

throw APIError.unimplemented("message"); // 501 Not Implemented

throw APIError.internal("message"); // 500 Internal Server Error

throw APIError.unavailable("message"); // 503 Unavailable

throw APIError.dataLoss("message"); // 500 Internal Server Error

throw APIError.unauthenticated("message"); // 401 Unauthorized

`})}]},databaseSection$1={slug:"database",heading:"Databases",overviewText:"Create SQL databases. Insert and read data.",description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["Here are some code snippets for using SQL databases with Encore."," ",docLink("/ts/primitives/databases")]}),icon:td=>icons.database(td.className??""),subSections:[{nav:"Create a database",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{children:["To create a database, import ",jsxRuntimeExports.jsx("code",{children:"encore.dev/storage/sqldb"})," and call new"," ",jsxRuntimeExports.jsx("code",{children:"SQLDatabas"}),", assigning the result to a top-level variable. Use a migration file in a directory ",jsxRuntimeExports.jsx("code",{children:"migrations"})," to define the database schema."]}),jsxRuntimeExports.jsx(CodeSnippet,{title:"Create a database",docsLink:"/ts/primitives/databases#creating-a-database",lang:"ts",value:`
import { SQLDatabase } from "encore.dev/storage/sqldb";

// Create the todo database and assign it to the "db" variable
const db = new SQLDatabase("todo", {
  migrations: "./migrations",
});`}),jsxRuntimeExports.jsxs("p",{children:[jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"Note:"})," If your application is already running when you define a new database, you will need to stop and restart your application with"," ",jsxRuntimeExports.jsx("code",{children:"encore run"}),". You must also have"," ",jsxRuntimeExports.jsx("a",{href:"https://docker.com",target:"_blank",className:"link-brandient brandient-5",children:"Docker"})," ","installed and running."]})]})},{nav:"Define a schema",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{children:["The first migration typically defines the initial table structure. For instance, a"," ",jsxRuntimeExports.jsx("code",{children:"todo"})," service might create"," ",jsxRuntimeExports.jsx("code",{children:"todo/migrations/1_create_table.up.sql"})," with the following content:"]}),jsxRuntimeExports.jsx(CodeSnippet,{title:"1_create_table.up.sql",docsLink:"/ts/primitives/databases#defining-the-database-schema",lang:"sql",value:`
CREATE TABLE todo_item (
    id BIGSERIAL PRIMARY KEY,
    title TEXT NOT NULL,
    done BOOLEAN NOT NULL DEFAULT false
);
`})]})},{nav:"Migration File Structure",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsxs("p",{children:["Migration files are created in a ",jsxRuntimeExports.jsx("code",{children:"migrations"})," directory within an Encore service package. Each file is named ",jsxRuntimeExports.jsx("code",{children:"number_name.up.sql"}),", where"," ",jsxRuntimeExports.jsx("code",{children:"number"})," is a sequence number for ordering and ",jsxRuntimeExports.jsx("code",{children:"name"})," describes the migration."]}),jsxRuntimeExports.jsx("p",{children:"Example Directory Structure:"}),jsxRuntimeExports.jsx(Code,{lang:"ts",rawContents:`
/my-app
├── encore.app                       // ... other top-level project files
│
└── todo                             // todo service
    ├── migrations                   // database migrations (directory)
    │   ├── 1_create_table.up.sql    // first migration file
    │   └── 2_add_field.up.sql       // second migration file
    ├── todo.ts                      // todo service code
    └── todo.test.ts                 // tests for todo service
`})]})},{nav:"Inserting data",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Inserting data",docsLink:"/ts/primitives/databases#inserting-data",lang:"ts",value:`
await db.exec\`
  INSERT INTO todo_item (title, done)
  VALUES (\${title}, false)
\`;
`})},{nav:"Querying data",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Querying data",docsLink:"/ts/primitives/databases#querying-data",lang:"ts",value:"const row = await db.query`SELECT title FROM todo_item WHERE id = ${id}`;"})},{nav:"Querying multiple rows",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Querying multiple rows",docsLink:"/ts/primitives/databases#querying-data",lang:"ts",value:`const allTodos = await db.query\`SELECT * FROM todo_item\`;
for await (const todo of allTodos) {
  // Process each todo
}`})}]},objectStorageSection$1={slug:"storage",heading:"Object Storage",overviewText:"Store and retrieve files and unstructured data.",icon:td=>icons.database(td.className??""),description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["Object Storage provides a simple and scalable solution to store files and unstructured data. Encore provides a cloud-agnostic API that works with Amazon S3, Google Cloud Storage, and any S3-compatible service. ",docLink("/ts/primitives/object-storage")]}),subSections:[{nav:"Creating a Bucket",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsx("p",{children:"Buckets must be declared as package level variables and can be accessed from any service."}),jsxRuntimeExports.jsx(CodeSnippet,{title:"Creating a Bucket",docsLink:"/ts/primitives/object-storage#creating-a-bucket",lang:"ts",value:`
import { Bucket } from "encore.dev/storage/objects";

export const profilePictures = new Bucket("profile-pictures", {
  versioned: false,
});`})]})},{nav:"Uploading files",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Uploading files",docsLink:"/ts/primitives/object-storage#uploading-files",lang:"ts",value:`
const data = Buffer.from(...); // image data
const attributes = await profilePictures.upload("my-image.jpeg", data, {
  contentType: "image/jpeg",
});`})},{nav:"Downloading files",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Downloading files",docsLink:"/ts/primitives/object-storage#downloading-files",lang:"ts",value:'const data = await profilePictures.download("my-image.jpeg");'})},{nav:"Listing objects",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Listing objects",docsLink:"/ts/primitives/object-storage#listing-objects",lang:"ts",value:`
for await (const entry of profilePictures.list({})) {
  console.log(entry.key);
}`})},{nav:"Deleting objects",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Deleting objects",docsLink:"/ts/primitives/object-storage#deleting-objects",lang:"ts",value:'await profilePictures.remove("my-image.jpeg");'})},{nav:"Public buckets",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsx("p",{children:"Configure a bucket to be publicly accessible and get public URLs for objects."}),jsxRuntimeExports.jsx(CodeSnippet,{title:"Public buckets",docsLink:"/ts/primitives/object-storage#configuring-public-buckets",lang:"ts",value:`
export const publicAssets = new Bucket("public-assets", {
  public: true,
  versioned: false,
});

// Get the public URL for an object
const url = publicAssets.publicUrl("logo.png");
console.log(\`Public URL: \${url}\`);`})]})},{nav:"Bucket references",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsx("p",{children:"Create references to buckets with specific permissions that can be passed around freely."}),jsxRuntimeExports.jsx(CodeSnippet,{title:"Bucket references",docsLink:"/ts/primitives/object-storage#bucket-references",lang:"ts",value:`
import { Uploader, Downloader } from "encore.dev/storage/objects";

// Get a reference with upload-only permissions
const uploaderRef = profilePictures.ref<Uploader>();

// Get a reference with multiple permissions
const readWriteRef = profilePictures.ref<Downloader & Uploader>();`})]})}]},cronJobsSection$1={slug:"cron",heading:"Cron Jobs",overviewText:"Create Cron Jobs by schedule or cron expression.",icon:ForwardRef$i,description:jsxRuntimeExports.jsxs("p",{children:["Cron Jobs are periodic tasks that automatically calls a predefined API endpoint on a schedule."," ",docLink("/ts/primitives/cron-jobs"),jsxRuntimeExports.jsx("br",{}),jsxRuntimeExports.jsx("br",{}),jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"Note:"})," Cron Jobs do not run when developing locally. However, you can test the behavior by calling the API Endpoint directly."]}),subSections:[{nav:"With basic schedule",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Basic schedule",docsLink:"/ts/primitives/cron-jobs#defining-a-cron-job",lang:"ts",value:`import { CronJob } from "encore.dev/cron";
import { api } from "encore.dev/api";

// Send a welcome email to everyone who signed up in the last two hours.
const _ = new CronJob("welcome-email", {
	title: "Send welcome emails",
	every: "2h",
	endpoint: sendWelcomeEmail,
})

// Emails everyone who signed up recently.
// It's idempotent: it only sends a welcome email to each person once.
export const sendWelcomeEmail = api({}, async () => {
	// Send welcome emails...
});`})},{nav:"With cron expression",content:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:[jsxRuntimeExports.jsx(CodeSnippet,{title:"Cron expression",docsLink:"/ts/primitives/cron-jobs#cron-schedules",lang:"ts",value:`// Run the monthly accounting sync job at 4am (UTC) on the 15th day of each month.
const _ = new CronJob("accounting-sync", {
	title:    "Cron Job Example",
	schedule: "0 4 15 * *",
	endpoint: accountingSync,
})`}),jsxRuntimeExports.jsxs("p",{className:"mt-5",children:[jsxRuntimeExports.jsx("span",{className:"font-semibold",children:"Note:"})," Cron schedule syntax is complex. See"," ",extLink$1("https://crontab.guru","crontab.guru")," for an explanation of cron schedule expressions."]})]})}]},pubSubSection$1={slug:"pubsub",heading:"Pub/Sub",overviewText:"Define topics/subscribers and customize retry behaviour.",icon:td=>icons.arrowsExpand(td.className??""),description:jsxRuntimeExports.jsxs(jsxRuntimeExports.Fragment,{children:["PubSub lets you build systems that communicate by broadcasting events asynchronously."," ",docLink("/ts/primitives/pubsub")]}),subSections:[{nav:"Define a topic",content:jsxRuntimeExports.jsx(CodeSnippet,{title:"Define a topic",docsLink:"/ts/primitives/pubsub#creating-a-topic",lang:"ts",value:`
            import { Topic } "encore.dev/pubsub"

export interface SignupEvent {
    userID: string;
}

export const signups = new Topic<SignupEvent>("signups", {
    deliveryGuarantee: "at-least-once",
