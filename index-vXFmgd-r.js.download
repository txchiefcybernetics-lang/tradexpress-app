  query previewSettings($appSlug: String!) {
    app(slug: $appSlug) {
      preview {
        enabled
        branchPatterns
        baseEnv {
          id
          name
        }
      }
      integrations(sel: { typeRef: "resource/neon.UserAccount" }) {
        id
      }
      envs(sel: { hasNeon: true }) {
        id
        name
        resources(sel: { type: "neon.Cloud" }) {
          __typename
        }
      }
    }
  }
`),setBaseEnvPreviewMutation=graphql$1(`
  mutation setBaseEnvPreview($appSlug: String!, $envID: EnvID!) {
    app(slug: $appSlug) {
      preview {
        setBaseEnv(env: $envID)
      }
    }
  }
`),clearBaseEnvPreviewMutation=graphql$1(`
  mutation clearBaseEnvPreview($appSlug: String!) {
    app(slug: $appSlug) {
      preview {
        clearBaseEnv(confirm: true)
      }
    }
  }
`),updatePreviewSettingsMutation=graphql$1(`
  mutation updatePreviewSettings($appSlug: String!, $enabled: Boolean, $branchPatterns: [String!]) {
    app(slug: $appSlug) {
      preview {
        update(input: { enabled: $enabled, branchPatterns: $branchPatterns }) {
          enabled
          branchPatterns
        }
      }
