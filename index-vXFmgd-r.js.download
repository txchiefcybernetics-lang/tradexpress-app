t:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"supportsGlobSearch"}},{kind:"Field",name:{kind:"Name",value:"buckets"},selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"encoreName"}}]}}]}}]}}]}}]}}]}}]},documents={"\n  query getPlainUserInfo {\n    me {\n      email\n      plain_email_hash\n      full_name\n      given_name\n      picture_url\n    }\n  }\n":GetPlainUserInfoDocument,"\n  mutation noopMutation($appSlug: String!) {\n    app(slug: $appSlug) {\n      id\n    }\n  }\n":NoopMutationDocument,"\n  query getSubscription($appSlug: String!) {\n    app(slug: $appSlug) {\n      __typename\n      envs {\n        id\n      }\n      members {\n        __typename\n        role\n        accepted\n        expires\n      }\n      subscription {\n        items {\n          quantity\n          plan {\n            interval\n          }\n          price {\n            currency\n            product {\n              id\n              metadata\n            }\n            ... on StripePerUnitPrice {\n              unitAmount\n            }\n          }\n        }\n      }\n    }\n  }\n":GetSubscriptionDocument,"\n  query createSubscription($appSlug: String!, $input: CreateSubscriptionInput!) {\n    app(slug: $appSlug) {\n      createSubscription(input: $input) {\n        url\n      }\n    }\n  }\n":CreateSubscriptionDocument,"\n  query getSubscriptionPortalURL($appSlug: String!, $returnURL: String!) {\n    app(slug: $appSlug) {\n      subscription {\n        manageSubscriptionPortal(input: { returnURL: $returnURL }) {\n          url\n        }\n      }\n    }\n  }\n":GetSubscriptionPortalUrlDocument,"\n  query getEstimatedInvoice($appSlug: String!) {\n    app(slug: $appSlug) {\n      subscription {\n        estimatedInvoice {\n          currency\n          periodStart\n          periodEnd\n          total\n          lines {\n            id\n            description\n            currency\n            currentAmount\n            estimatedAmount\n            estimatedVolume\n            isMetered\n            periodStart\n            periodEnd\n            quantity\n            proration\n            product {\n              name\n              unitLabel\n            }\n            tiers {\n              currentAmount\n              currentVolume\n              estimatedAmount\n              estimatedVolume\n              unitAmountDecimal\n              flatAmountDecimal\n              upTo\n            }\n          }\n        }\n      }\n    }\n  }\n":GetEstimatedInvoiceDocument,"\n  query getUserRole($appSlug: String!) {\n    app(slug: $appSlug) {\n      userRole\n    }\n  }\n":GetUserRoleDocument,"\n  query cronJobsQuery($appSlug: String!, $envSlug: String!) {\n    app(slug: $appSlug) {\n      userRole\n      env(includeDeleted: false, name: $envSlug) {\n        name\n        cronJobs {\n          name\n          id\n          description\n          isDeleted\n          httpMethod\n          rpcPath\n          paused\n          schedule\n          lastExecution {\n            status\n            time\n            traceID\n          }\n          nextExecution {\n            status\n            time\n          }\n        }\n      }\n    }\n  }\n":CronJobsQueryDocument,"\n  query cronJobExecutionQuery(\n    $appSlug: String!\n    $envSlug: String!\n    $id: ResourceID!\n    $executionID: CronExecutionID!\n  ) {\n    app(slug: $appSlug) {\n      env(includeDeleted: false, name: $envSlug) {\n        cronJobs(sel: { id: $id }) {\n          execution(id: $executionID) {\n            traceID\n            time\n            status\n          }\n        }\n      }\n    }\n  }\n":CronJobExecutionQueryDocument,"\n  mutation cronPauseMutation($appSlug: String!, $envSlug: String!, $id: ResourceID!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        cronJob(id: $id) {\n          pause(confirm: true)\n        }\n      }\n    }\n  }\n":CronPauseMutationDocument,"\n  mutation cronResumeMutation($appSlug: String!, $envSlug: String!, $id: ResourceID!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        cronJob(id: $id) {\n          resume(confirm: true)\n        }\n      }\n    }\n  }\n":CronResumeMutationDocument,"\n  mutation cronRunMutation($appSlug: String!, $envSlug: String!, $id: ResourceID!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        cronJob(id: $id) {\n          run(confirm: true)\n        }\n      }\n    }\n  }\n":CronRunMutationDocument,"\n  query getAWSRDSImportPath(\n    $appSlug: String!\n    $resourceType: TypeRef!\n    $providerID: String!\n    $integrationID: IntegrationID\n  ) {\n    app(slug: $appSlug) {\n      getImportPath(typ: $resourceType, providerID: $providerID, integrationID: $integrationID) {\n        path\n        name\n      }\n    }\n  }\n":GetAwsrdsImportPathDocument,'\n  query awsAccounts($appSlug: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { typeRef: "resource/aws.ExternalRole" }) {\n        name\n        id\n        ... on AWSAccount {\n          accountId\n          roleArn\n        }\n      }\n    }\n  }\n':AwsAccountsDocument,'\n  query cloudflareAccounts($appSlug: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { typeRef: "resource/cloudflare.APIToken" }) {\n        name\n        id\n      }\n    }\n  }\n':CloudflareAccountsDocument,"\n  query cloudflareProjects($appSlug: String!, $integID: IntegrationID!) {\n    app(slug: $appSlug) {\n      integrations(sel: { id: $integID }) {\n        ... on CloudflareToken {\n          accounts {\n            name\n            id\n          }\n        }\n      }\n    }\n  }\n":CloudflareProjectsDocument,"\n  query cloudflareZones($appSlug: String!, $integID: IntegrationID!, $accountID: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { id: $integID }) {\n        ... on CloudflareToken {\n          accounts(id: $accountID) {\n            zones {\n              domain\n              id\n            }\n          }\n        }\n      }\n    }\n  }\n":CloudflareZonesDocument,"\n  query listCloudflareRegions($appSlug: String!) {\n    app(slug: $appSlug) {\n      resourceMetadata {\n        cloudflare {\n          regions {\n            name\n            id\n          }\n        }\n      }\n    }\n  }\n":ListCloudflareRegionsDocument,"\n  fragment CloudflareAccount on CloudflareAccount {\n    id\n    name\n  }\n":CloudflareAccountFragmentDoc,'\n  query gcpServiceAccountKeys($appSlug: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { typeRef: "resource/gcp.ServiceAccountKey" }) {\n        name\n        id\n        ... on GCPServiceAccountKey {\n          clientEmail\n        }\n      }\n    }\n  }\n':GcpServiceAccountKeysDocument,"\n  query gcpServiceAccountKeyResources($appSlug: String!, $id: IntegrationID!) {\n    app(slug: $appSlug) {\n      integrations(sel: { id: $id }) {\n        ... on GCPServiceAccountKey {\n          projects {\n            id\n            displayName\n          }\n          organizations {\n            id\n            displayName\n          }\n        }\n      }\n    }\n  }\n":GcpServiceAccountKeyResourcesDocument,"\n  query gcpOrganizationBillingAccounts($appSlug: String!, $id: IntegrationID!, $orgId: CloudName!) {\n    app(slug: $appSlug) {\n      integrations(sel: { id: $id }) {\n        ... on GCPServiceAccountKey {\n          organizations(id: $orgId) {\n            id\n            billingAccounts {\n              id\n              displayName\n              open\n            }\n          }\n        }\n      }\n    }\n  }\n":GcpOrganizationBillingAccountsDocument,'\n  query hasConnectedAccounts($appSlug: String!) {\n    app(slug: $appSlug) {\n      neon: integrations(sel: { typeRef: "resource/neon.UserAccount" }) {\n        id\n      }\n      cloudflare: integrations(sel: { typeRef: "resource/cloudflare.APIToken" }) {\n        id\n      }\n    }\n  }\n':HasConnectedAccountsDocument,'\n  query neonAccounts($appSlug: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { typeRef: "resource/neon.UserAccount" }) {\n        name\n        id\n        ... on NeonCloudAccount {\n          projectScope\n        }\n      }\n    }\n  }\n':NeonAccountsDocument,"\n  query neonProjects($appSlug: String!, $integID: IntegrationID!, $projectID: String) {\n    app(slug: $appSlug) {\n      integrations(sel: { id: $integID }) {\n        ... on NeonCloudAccount {\n          projects(id: $projectID) {\n            name\n            id\n          }\n        }\n      }\n    }\n  }\n":NeonProjectsDocument,"\n  query neonBranches($appSlug: String!, $integID: IntegrationID!, $projectID: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { id: $integID }) {\n        ... on NeonCloudAccount {\n          projects(id: $projectID) {\n            branches {\n              name\n              id\n            }\n          }\n        }\n      }\n    }\n  }\n":NeonBranchesDocument,"\n  query listNeonRegions($appSlug: String!) {\n    app(slug: $appSlug) {\n      resourceMetadata {\n        neon {\n          regions\n        }\n      }\n    }\n  }\n":ListNeonRegionsDocument,"\n  fragment NeonAccount on NeonAccount {\n    type\n  }\n":NeonAccountFragmentDoc,'\n  query listNeonEnvs($appSlug: String!) {\n    app(slug: $appSlug) {\n      envs(sel: { hasNeon: true }) {\n        id\n        name\n        resources(sel: { type: "neon.Cloud" }) {\n          ...NeonAccount\n        }\n      }\n    }\n  }\n':ListNeonEnvsDocument,"\n  query getAppOverview($appSlug: String!, $envName: String!) {\n    app(slug: $appSlug) {\n      secrets {\n        key\n        groups {\n          archivedAt\n        }\n      }\n\n      env(name: $envName) {\n        name\n\n        cronJobs {\n          name\n          isDeleted\n          lastExecution {\n            status\n            time\n          }\n        }\n\n        insights {\n          num_services\n          num_services_30d\n          num_endpoints\n          num_endpoints_30d\n          num_requests_24h\n          num_errors_24h\n          num_requests_24h_last_week\n          num_errors_24h_last_week\n          num_requests_1m\n          num_errors_1m\n\n          endpoints_top_requests_24h {\n            service\n            endpoint\n            count\n          }\n\n          endpoints_top_errors_24h {\n            service\n            endpoint\n            count\n          }\n        }\n      }\n\n      insights {\n        num_envs\n        num_envs_30d\n      }\n    }\n  }\n":GetAppOverviewDocument,"\n  query getEnvStyling($appSlug: String!, $envSlug: String!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        id\n        color\n        config {\n          limitToBranches\n        }\n        icon {\n          id\n          name\n          tags\n          ... on SVGIcon {\n            svg\n          }\n          ... on EmojiIcon {\n            section\n            description\n            unicode\n          }\n        }\n      }\n    }\n  }\n":GetEnvStylingDocument,"\n  mutation updateEnvSettings($appSlug: String!, $envSlug: String!, $input: EnvUpdateInput!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        update(input: $input) {\n          id\n          color\n          icon {\n            id\n            name\n            tags\n            ... on SVGIcon {\n              svg\n            }\n            ... on EmojiIcon {\n              section\n              description\n              unicode\n            }\n          }\n        }\n      }\n    }\n  }\n":UpdateEnvSettingsDocument,"\n  query getDeleteProtectedResources($appSlug: String!, $envSlug: String!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        resources(sel: { deleteProtection: true }) {\n          data {\n            label\n            deleteInstructions {\n              instructions\n              url\n            }\n          }\n        }\n      }\n    }\n  }\n":GetDeleteProtectedResourcesDocument,"\n  query getGCPCloudSQLImportPath(\n    $appSlug: String!\n    $resourceType: TypeRef!\n    $providerID: String!\n    $integrationID: IntegrationID\n  ) {\n    app(slug: $appSlug) {\n      getImportPath(typ: $resourceType, providerID: $providerID, integrationID: $integrationID) {\n        path\n        name\n      }\n    }\n  }\n":GetGcpCloudSqlImportPathDocument,"\n  query getGCPK8sImportPath(\n    $appSlug: String!\n    $resourceType: TypeRef!\n    $providerID: String!\n    $integrationID: IntegrationID\n  ) {\n    app(slug: $appSlug) {\n      getImportPath(typ: $resourceType, providerID: $providerID, integrationID: $integrationID) {\n        path\n        name\n      }\n    }\n  }\n":GetGcpk8sImportPathDocument,"\n  query getGCPNetworkImportPath(\n    $appSlug: String!\n    $resourceType: TypeRef!\n    $providerID: String!\n    $integrationID: IntegrationID\n  ) {\n    app(slug: $appSlug) {\n      getImportPath(typ: $resourceType, providerID: $providerID, integrationID: $integrationID) {\n        path\n        name\n      }\n    }\n  }\n":GetGcpNetworkImportPathDocument,"\n  query getEnvJitProviders($appSlug: String!, $envSlug: String!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        id\n        jitProviders {\n          configType\n          appDefault {\n            type\n            values\n          }\n          envDefault {\n            type\n            values\n          }\n          nodes {\n            resourceId\n            name\n            enabled\n            override {\n              type\n              values\n            }\n            effective {\n              type\n              values\n            }\n          }\n        }\n      }\n    }\n  }\n":GetEnvJitProvidersDocument,"\n  mutation setEnvJitConfig($appSlug: String!, $envSlug: String!, $type: String!, $values: Any!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        updateConfig(type: $type, values: $values) {\n          type\n          values\n        }\n      }\n    }\n  }\n":SetEnvJitConfigDocument,"\n  mutation setNodeJitConfig(\n    $appSlug: String!\n    $envSlug: String!\n    $resourceId: ResourceID!\n    $type: String!\n    $values: Any!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        resources(sel: { id: $resourceId }) {\n          updateConfig(type: $type, values: $values) {\n            type\n            values\n          }\n        }\n      }\n    }\n  }\n":SetNodeJitConfigDocument,"\n  mutation clearNodeJitConfig(\n    $appSlug: String!\n    $envSlug: String!\n    $resourceId: ResourceID!\n    $type: String!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        resources(sel: { id: $resourceId }) {\n          deleteConfig(type: $type)\n        }\n      }\n    }\n  }\n":ClearNodeJitConfigDocument,"\n  query getStoredRequests($appSlug: String!) {\n    app(slug: $appSlug) {\n      storedRequests {\n        id\n        title\n        rpcName\n        svcName\n        shared\n        data {\n          method\n          pathParams\n          payload\n        }\n      }\n    }\n  }\n":GetStoredRequestsDocument,"\n  mutation createStoredRequest($appSlug: String!, $input: StoredRequestInput!) {\n    app(slug: $appSlug) {\n      createStoredRequest(req: $input) {\n        id\n      }\n    }\n  }\n":CreateStoredRequestDocument,"\n  mutation updateStoredRequest(\n    $appSlug: String!\n    $storedRequestID: StoredRequestID!\n    $input: StoredRequestInput!\n  ) {\n    app(slug: $appSlug) {\n      storedRequest(id: $storedRequestID) {\n        update(input: $input) {\n          id\n        }\n      }\n    }\n  }\n":UpdateStoredRequestDocument,"\n  mutation deleteStoredRequest($appSlug: String!, $storedRequestID: StoredRequestID!) {\n    app(slug: $appSlug) {\n      storedRequest(id: $storedRequestID) {\n        delete(confirm: true)\n      }\n    }\n  }\n":DeleteStoredRequestDocument,"\n  query costDataQuery($appSlug: String!, $envName: String!) {\n    app(slug: $appSlug) {\n      userRole\n      env(name: $envName, includeDeleted: true) {\n        costCollectors {\n          id\n        }\n      }\n    }\n  }\n":CostDataQueryDocument,"\n  mutation costCollectorMutation(\n    $appSlug: String!\n    $envName: String!\n    $datasetID: String!\n    $projectID: String!\n  ) {\n    app(slug: $appSlug) {\n      env(includeDeleted: false, name: $envName) {\n        addGCPCostCollector(datasetID: $datasetID, projectID: $projectID) {\n          id\n        }\n      }\n    }\n  }\n":CostCollectorMutationDocument,"\n  mutation cancelProposedActions($appSlug: String!, $envName: String!) {\n    app(slug: $appSlug) {\n      env(name: $envName) {\n        actions(sel: { status: PROPOSED }) {\n          cancel {\n            id\n          }\n        }\n      }\n    }\n  }\n":CancelProposedActionsDocument,"\n  mutation approveProposedActions($appSlug: String!, $envName: String!) {\n    app(slug: $appSlug) {\n      env(name: $envName) {\n        actions(sel: { status: PROPOSED }) {\n          approve {\n            id\n          }\n        }\n      }\n    }\n  }\n":ApproveProposedActionsDocument,"\n  mutation abortInfraChange($appSlug: String!, $envSlug: String!, $rolloutID: RolloutID!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug, includeDeleted: false) {\n        rollouts(sel: { id: $rolloutID }) {\n          abort {\n            id\n          }\n        }\n      }\n    }\n  }\n":AbortInfraChangeDocument,"\n  mutation rejectInfraChange($appSlug: String!, $envSlug: String!, $rolloutID: RolloutID!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug, includeDeleted: false) {\n        rollouts(sel: { id: $rolloutID }) {\n          reject {\n            id\n          }\n        }\n      }\n    }\n  }\n":RejectInfraChangeDocument,"\n  mutation approveInfraChange($appSlug: String!, $envSlug: String!, $rolloutID: RolloutID!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug, includeDeleted: false) {\n        rollouts(sel: { id: $rolloutID }) {\n          approve {\n            id\n          }\n        }\n      }\n    }\n  }\n":ApproveInfraChangeDocument,"\n  mutation moveNeed(\n    $appSlug: String!\n    $envSlug: String!\n    $itemID: ResourceID!\n    $targetCloudRunId: ResourceID!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        needs(sel: { id: $itemID }) {\n          move(parent: $targetCloudRunId, proposal: true) {\n            id\n          }\n        }\n      }\n    }\n  }\n":MoveNeedDocument,"\n  mutation moveNeedToAncestor(\n    $appSlug: String!\n    $envSlug: String!\n    $itemID: ResourceID!\n    $ancestor: TypeRef!\n    $key: String!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        needs(sel: { id: $itemID }) {\n          moveToAncestor(ancestor: $ancestor, key: $key, proposal: true) {\n            id\n          }\n        }\n      }\n    }\n  }\n":MoveNeedToAncestorDocument,"\n  mutation moveNeedToImport(\n    $appSlug: String!\n    $envSlug: String!\n    $itemID: ResourceID!\n    $providerID: String!\n    $typ: TypeRef!\n    $integrationID: IntegrationID!\n  ) {\n    app(slug: $appSlug) {\n      env(name: $envSlug) {\n        needs(sel: { id: $itemID }) {\n          moveToImport(\n            providerID: $providerID\n            typ: $typ\n            integrationID: $integrationID\n            proposal: true\n          ) {\n            id\n          }\n        }\n      }\n    }\n  }\n":MoveNeedToImportDocument,'\n  query awsIntegrationsForImport($appSlug: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { typeRef: "resource/aws.ExternalRole" }) {\n        id\n        name\n        ... on AWSAccount {\n          accountId\n        }\n      }\n    }\n  }\n':AwsIntegrationsForImportDocument,'\n  query gcpIntegrationsForImport($appSlug: String!) {\n    app(slug: $appSlug) {\n      integrations(sel: { typeRef: "resource/gcp.ServiceAccountKey" }) {\n        id\n        name\n      }\n    }\n  }\n':GcpIntegrationsForImportDocument,"\n  query showDatabaseUsers($appSlug: String!, $envSlug: String!, $id: ResourceID!) {\n    app(slug: $appSlug) {\n      env(name: $envSlug, includeDeleted: false) {\n        decryptSQLUserPassword(id: $id)\n      }\n    }\n  }\n":ShowDatabaseUsersDocument,"\n  fragment ResourceBaseData on ResourceBaseData {\n    id\n    cloudDashboardURL\n    label\n    type\n    name\n    region\n    encoreName\n    unused\n    provider\n    status\n    changeStatus\n    changeConclusion\n    userManaged\n    stateful\n    cost {\n      cost1Day\n      cost1DayPrev\n      cost7Day\n      cost7DayPrev\n      cost28Day\n      cost28DayPrev\n      sku {\n        description\n      }\n      minDate\n    }\n  }\n":ResourceBaseDataFragmentDoc,"\n  fragment SQLUser on SQLUser {\n    data {\n      ...ResourceBaseData\n    }\n    username\n    readonly\n    superuser\n  }\n":SqlUserFragmentDoc,"\n  fragment BasicResource on BasicResource {\n    data {\n      ...ResourceBaseData\n    }\n  }\n":BasicResourceFragmentDoc,"\n  fragment PubSubTopic on PubSubTopic {\n    subscriptions {\n      ...PubSubSubscription\n    }\n    data {\n      ...ResourceBaseData\n    }\n    ... on AWSSNSTopic {\n      need {\n        id\n      }\n    }\n    ... on GCPPubSubTopic {\n      need {\n        id\n      }\n    }\n  }\n":PubSubTopicFragmentDoc,"\n  fragment Bucket on Bucket {\n    data {\n      ...ResourceBaseData\n    }\n    uri\n    buckets {\n      id\n      encoreName\n      created\n    }\n    versioned\n  }\n":BucketFragmentDoc,"\n  fragment PubSubSubscription on PubSubSubscription {\n    topic {\n      data {\n        ...ResourceBaseData\n      }\n    }\n    data {\n      ...ResourceBaseData\n    }\n    ... on GCPPubSubSubscription {\n      deliveryType\n    }\n  }\n":PubSubSubscriptionFragmentDoc,"\n  fragment NeonEndpoint on NeonEndpoint {\n    host\n    type\n    poolerEnabled {\n      requested\n      current\n    }\n    suspendTimeoutSeconds {\n      requested\n      current\n    }\n  